rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated()
        && request.auth.uid == userId;
    }

    // ==========================================
    // USUARIOS
    // ==========================================

    match /users/{userId} {

      // Cada usuario puede consultar su perfil.
      allow get: if isOwner(userId);

      // No permitimos listar todos los usuarios.
      allow list: if false;

      // Los perfiles se crearán mediante
      // un proceso seguro de servidor.
      allow create, update, delete: if false;

      // ========================================
      // DISPOSITIVOS Y NOTIFICACIONES
      // ========================================

      match /devices/{installationId} {

        // El usuario puede consultar sus dispositivos.
        allow read: if isOwner(userId);

        // Activaremos la escritura cuando
        // implementemos los tokens push.
        allow create, update, delete: if false;
      }
    }

    // ==========================================
    // RESTO DE COLECCIONES
    // ==========================================

    // Centros, trabajadores, reservas, pacientes,
    // bonos e historias clínicas permanecen
    // protegidos hasta implementar sus permisos.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}